% bibliography/references.bib — リポジトリ共通の書誌データ
%
% Zotero の Better BibTeX プラグインから、このファイルを自動エクスポート先に
% 指定して使う（Zotero > 右クリック > Export Library > Better BibTeX >
% "Keep updated" にチェック）。Zotero 側で文献を足すと自動で書き換わる。
%
% 参照する側:
%   - /md-to-pdf, /md-to-docx      本文の引用キーをこのファイルで解決する
%   - .claude/skills/md-to-pdf/assets/templates/*        main.tex の \addbibresource がこのファイルを指す
%
% 【注意】このコメント欄にアットマーク記号を書かないこと。BibTeX は行頭以外でも
% アットマークを見つけるとエントリの開始とみなし、「I was expecting a `{'」で
% 止まる。引用キーの例を書きたいときは記号を省いて「citekey」とだけ書く。
%
% Zotero を使わず手で書く場合は、このファイルに直接追記してよい。
% preamble-ja.tex の言語別書式は langid を、文献一覧の節分けは keywords を見る。
%
% ===== 日本語の著者名は姓と名をカンマで区切る =====
%   ○ author = {山田, 太郎}   Zotero で姓・名の欄を分けて入れるとこの形で出力される
%   × author = {山田 太郎}    空白区切りは「名 姓」と読まれ、姓が「太郎」になる
%   △ author = {山田太郎}     全体が姓とみなされ、脚注が姓だけに短縮されない
%
% citeproc（/md-to-pdf）での実測（2026-10-02、chicago-shortened-notes-bibliography.csl）:
%   {山田, 太郎} → 文献一覧「山田太郎」・脚注「山田」      ← 期待どおり
%   {山田太郎}   → 文献一覧「山田太郎」・脚注「山田太郎」  ← 短縮されない
%   {山田 太郎}  → 文献一覧「太郎」・脚注「太郎」          ← 姓が失われる
% citeproc は CJK の人名を判別し、姓名を空白なしで連結する。データ側で
% 姓名をまとめる必要はない。
%
% 【未検証】学会クラスの pBibTeX 経路（ipsj 雛形など）は挙動を確認していない。
% 表示の調整は本来スタイル側（.csl / .bst）の仕事なので、.bib のデータを
% 歪めて回避しないこと。

% ===== 研究文献（邦語） =====
@book{yamada2020,
  author    = {山田太郎},
  title     = {サンプル書籍のタイトル},
  subtitle  = {副題の表示確認},
  publisher = {学術出版社},
  location  = {東京},
  year      = {2020},
  langid    = {japanese},
  keywords  = {japanese},
}

% ===== 研究文献（欧語） =====
@article{smith2019,
  author    = {Smith, John and Doe, Jane},
  title     = {A Sample Article for Testing},
  journal   = {Journal of Digital Humanities},
  volume    = {3},
  number    = {1},
  pages     = {35--58},
  year      = {2019},
  langid    = {english},
}

% ===== 未公刊史料（thesis 雛形の文献一覧で「史料」に分類される）=====
% 未公刊史料は author を持たないことが多い。空の author = {} は書かず、
% フィールドごと省略する（biblatex が title を主見出しに使う）。
@misc{archive_sample,
  title     = {文書群の名称（例：○○家文書）},
  note      = {所蔵機関名、請求記号},
  year      = {1700},
  langid    = {japanese},
  keywords  = {source-archive, japanese},
}

% ===== 刊行史料 =====
@book{printed_sample,
  author    = {鈴木花子},
  title     = {刊行史料集のタイトル},
  publisher = {出版社},
  location  = {東京},
  year      = {1980},
  langid    = {japanese},
  keywords  = {source-printed, japanese},
}
