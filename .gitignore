__pycache__/
*.pyc
*.pyo
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
credentials/
secrets/

# macOS
.DS_Store

# Microsoft Office 一時ロックファイル
~$*

# Claude のローカル設定
.claude/settings.local.json

# よくある生成物
*.log
*.sqlite
*.db

# 各 work の生成結果
work/*/outputs/*
!work/*/outputs/.gitkeep

# 独立Gitリポジトリの置き場。外側Gitでは追跡しない。
# ここを追跡すると入れ子リポジトリが gitlink として登録され、中身も履歴も壊れる
repos/*
!repos/.gitkeep
!repos/README.md

# 完成版の書き出し。サイズが大きいので履歴には入れない
publications/**/*.pdf
publications/**/*.pptx
publications/**/*.docx

# 完成版の置き場に .tex は要らない（原稿は work/publications/ 側にある）
publications/**/*.tex

# 履歴書の基本情報。生年月日・住所・電話番号を入れる場所なので既定では追跡しない。
# 使うときは cv/master/01_基本情報.csv.example をコピーする
cv/master/01_基本情報.csv

# LaTeX 生成物
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.toc
